# Copy to .env.local and fill in real values. Never commit secrets.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESTRICTED_STATES=WA,ID,NV,MI

# ── Cron (/api/cron/*) ───────────────────────────────────────────────────────
CRON_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_PROMO_CHAT_ID=
TELEGRAM_ADMIN_BOT_USERNAME=
TELEGRAM_CUSTOMER_BOT_USERNAME=
TELEGRAM_CHAT_FINANCE=
TELEGRAM_CHAT_USERS=
TELEGRAM_CHAT_SWEEPSTAKES=
TELEGRAM_CHAT_ERRORS=
TELEGRAM_CHAT_REPORTS=

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Legacy env key name (do not rename in Vercel — would break chat sender identity)
SPINORA_BOT_SENDER_ID=

# ── Paydora ──────────────────────────────────────────────────────────────────
# Webhook URL: https://YOUR-DOMAIN/api/payments/paydora/webhook
PAYDORA_API_BASE_URL=https://cpcs.paydora.net/api/v1
PAYDORA_API_KEY=
PAYDORA_WEBHOOK_SECRET=

# ── Public deposit handles (no hardcoded fallbacks in code) ──────────────────
NEXT_PUBLIC_DEPOSIT_PAYPAL=
